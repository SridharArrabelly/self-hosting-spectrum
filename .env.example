# ============================================================================
# self-hosting-spectrum - copy to .env and fill in.
# Values marked (generated) are written by infra/scripts/deploy.py.
# ============================================================================

# ---- Azure context ---------------------------------------------------------
AZURE_TENANT_ID=b1cd5b73-a77b-4002-a5a6-1599e4c4ee37
AZURE_SUBSCRIPTION_ID=40b687ca-31b5-4374-bea2-4c178369b9c0
AZURE_LOCATION=eastus2
RESOURCE_GROUP=rg-self-hosting-spectrum
# Short suffix appended to globally-unique resource names (3-8 lowercase chars).
NAME_SUFFIX=shs01

# ---- API Management --------------------------------------------------------
# Developer is the cheapest SKU that still supports llm-token-limit.
APIM_SKU=Developer
APIM_PUBLISHER_EMAIL=you@example.com
APIM_PUBLISHER_NAME=Self Hosting Spectrum
# (generated) https://<apim-name>.azure-api.net
APIM_GATEWAY_URL=
# (generated) subscription key for the unified product
APIM_SUBSCRIPTION_KEY=

# ---- Foundry ---------------------------------------------------------------
# (generated) https://<account>.services.ai.azure.com
FOUNDRY_ENDPOINT=
FOUNDRY_PROJECT_NAME=proj-spectrum
# (generated) project endpoint used by azure-ai-projects
FOUNDRY_PROJECT_ENDPOINT=

# ---- Option 1: Managed Compute --------------------------------------------
# Model from the azure-huggingface / azureml registries.
MC_MODEL=
MC_DEPLOYMENT_NAME=managed-compute
# A100_80GB | H100_80GB | MI300X   (A100 is roughly half the price of H100)
MC_ACCELERATOR=A100_80GB
MC_INSTANCE_COUNT=1

# ---- Option 2: Fireworks on Foundry ---------------------------------------
# Catalog id. Small models are PTU-only; this one is pay-as-you-go.
FIREWORKS_MODEL=FW-Nemotron-Lightning-3.5-30B-A3B
FIREWORKS_DEPLOYMENT_NAME=fireworks

# ---- Option 3: Azure VM ----------------------------------------------------
# CPU default needs no GPU quota. For GPU use Standard_NC4as_T4_v3 + runtime=vllm.
VM_SIZE=Standard_D4s_v5
VM_RUNTIME=ollama
VM_MODEL=qwen2.5:1.5b-instruct
VM_ADMIN_USERNAME=azureuser
# (generated) private endpoint FQDN reached by APIM
VM_BACKEND_URL=

# ---- Option 4: Foundry Local ----------------------------------------------
FOUNDRY_LOCAL_MODEL=qwen2.5-0.5b-instruct-generic-cpu
FOUNDRY_LOCAL_PORT=39839
DEVTUNNEL_NAME=shs-foundry-local
# (generated) https://<id>-39839.<region>.devtunnels.ms
FOUNDRY_LOCAL_TUNNEL_URL=

# ---- Gateway policy tuning -------------------------------------------------
TOKEN_LIMIT_PER_MINUTE=20000
ENABLE_CONTENT_SAFETY=false
