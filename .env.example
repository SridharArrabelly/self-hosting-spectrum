# ============================================================================
# self-hosting-spectrum - copy to .env and fill in.
# Values marked (generated) are written by infra/scripts/deploy.py.
# ============================================================================

# ---- Azure context ---------------------------------------------------------
AZURE_TENANT_ID=b1cd5b73-a77b-4002-a5a6-1599e4c4ee37
AZURE_SUBSCRIPTION_ID=40b687ca-31b5-4374-bea2-4c178369b9c0
AZURE_LOCATION=eastus2
RESOURCE_GROUP=rg-self-hosting-spectrum
# Short suffix appended to globally-unique resource names (3-8 lowercase chars).
NAME_SUFFIX=shs01

# ---- API Management --------------------------------------------------------
# Developer is the cheapest SKU that still supports llm-token-limit.
APIM_SKU=Developer
APIM_PUBLISHER_EMAIL=you@example.com
APIM_PUBLISHER_NAME=Self Hosting Spectrum
# (generated) https://<apim-name>.azure-api.net
APIM_GATEWAY_URL=

# ---- Gateway authentication ------------------------------------------------
# entra = keyless. Callers present a Microsoft Entra token and no shared secret
#         exists anywhere in the repository. This is the default.
# key   = the APIM subscription key below. Kept for migration demos and for
#         clients that genuinely cannot obtain a token.
# both  = accept either, which is what a real migration looks like mid-flight.
GATEWAY_AUTH_MODE=entra
# Resource the gateway token is issued for. Must match the Audience field on the
# Foundry BYOM connection, because the same route serves a developer's CLI token
# and the Foundry project's managed identity.
ENTRA_AUDIENCE=https://cognitiveservices.azure.com
# (generated by infra/scripts/setup_entra.py) comma-separated application IDs
# allowed through the gateway. Empty means any caller in the tenant holding a
# valid token for the audience above.
ENTRA_ALLOWED_CLIENT_IDS=
# (generated by infra/scripts/setup_entra.py) the Foundry project managed
# identity's application ID, recorded for troubleshooting.
FOUNDRY_PROJECT_MI_CLIENT_ID=
# (generated only for GATEWAY_AUTH_MODE=key or both)
APIM_SUBSCRIPTION_KEY=

# ---- Foundry ---------------------------------------------------------------
# (generated) https://<account>.services.ai.azure.com
FOUNDRY_ENDPOINT=
FOUNDRY_PROJECT_NAME=proj-spectrum
# (generated) project endpoint used by azure-ai-projects
FOUNDRY_PROJECT_ENDPOINT=

# ---- Option 1: Managed Compute --------------------------------------------
# Model from the azure-huggingface / azureml registries.
MC_MODEL=
MC_DEPLOYMENT_NAME=managed-compute
# A100_80GB | H100_80GB | MI300X   (A100 is roughly half the price of H100)
MC_ACCELERATOR=A100_80GB
MC_INSTANCE_COUNT=1

# ---- Option 2: Fireworks on Foundry ---------------------------------------
# Catalog id. Small models are PTU-only; this one is pay-as-you-go.
FIREWORKS_MODEL=FW-GLM-5.3-Flash
FIREWORKS_SKU=GlobalStandard
FIREWORKS_DEPLOYMENT_NAME=fireworks

# ---- Option 3: Azure VM ----------------------------------------------------
# CPU default needs no GPU quota. For GPU use Standard_NC4as_T4_v3 + runtime=vllm.
# NOTE: eastus2 on this subscription offers only v6/v7 D-series, and v6 is
# restricted - D4s_v7 (4 vCPU / 16 GB, ~$0.27/hr) is the smallest unrestricted fit.
# preflight.py verifies availability and quota for whatever you set here.
VM_SIZE=Standard_D4s_v7
VM_RUNTIME=ollama
VM_MODEL=qwen2.5:1.5b-instruct
VM_ADMIN_USERNAME=azureuser
# SSH public key contents. infra/scripts/deploy.py generates one at
# ~/.ssh/shs_spectrum if this is left empty.
VM_ADMIN_PUBLIC_KEY=
# CIDR allowed to SSH the VM. Empty means no SSH rule is created at all
# (APIM still reaches the inference port via the ApiManagement service tag).
VM_SSH_SOURCE_CIDR=
# (generated) private endpoint FQDN reached by APIM
VM_BACKEND_URL=

# ---- Option 4: Foundry Local ----------------------------------------------
FOUNDRY_LOCAL_MODEL=qwen2.5-0.5b
FOUNDRY_LOCAL_PORT=39839
DEVTUNNEL_NAME=shs-foundry-local
# (generated) https://<id>-39839.<region>.devtunnels.ms
FOUNDRY_LOCAL_TUNNEL_URL=

# ---- Gateway policy tuning -------------------------------------------------
TOKEN_LIMIT_PER_MINUTE=20000
ENABLE_CONTENT_SAFETY=false
