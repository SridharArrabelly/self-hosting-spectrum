<!--
  Shared inbound policy applied to all four hosting options.

  This fragment is the whole point of the repository: one identical set of
  gateway controls in front of four completely different runtimes - Foundry
  Managed Compute, a Fireworks partner deployment, a VM you own, and a model
  running on a laptop.

  The llm-* policies are schema-gated, not provider-gated. They work against
  any backend that speaks the OpenAI Chat Completions schema, which is why the
  same fragment can front a Fireworks deployment and an Ollama process on a VM.
  Use llm-* names only; the older azure-openai-* names are the consolidated
  legacy spelling.

  Token accounting needs a `usage` object in the response. All four backends
  return one for non-streamed calls. For streamed calls the client must send
  stream_options: {"include_usage": true} or the counts are estimates.
-->
<fragment>
  <!--
    Inbound authentication.

    Two modes, selected by the spectrum-auth-mode named value:

      entra   Microsoft Entra bearer tokens only. No shared secret exists
              anywhere in the system. This is the default.
      key     APIM subscription key, for clients that cannot obtain a token.
      both    Accept either, which is what a real migration looks like.

    APIM validates its own subscription key before any policy runs, so a policy
    cannot rescue a client that sends a key in an unexpected place. The APIs are
    therefore declared with subscriptionRequired=false and both checks happen
    here instead.
  -->
  <choose>
    <!-- Keyless. Validate a Microsoft Entra token. -->
    <when condition="@(!string.Equals("{{spectrum-auth-mode}}", "key", StringComparison.OrdinalIgnoreCase))">
      <validate-azure-ad-token
        tenant-id="{{spectrum-tenant-id}}"
        header-name="Authorization"
        output-token-variable-name="jwt"
        failed-validation-httpcode="401"
        failed-validation-error-message="Unauthorized. Send an Entra bearer token for audience {{spectrum-entra-audience}}."
        require-expiration-time="true"
        require-signed-tokens="true">
        <audiences>
          <audience>{{spectrum-entra-audience}}</audience>
        </audiences>
      </validate-azure-ad-token>

      <!--
        Read the calling application out of the token.

        Jwt.Claims maps each claim to a string[], not a string, so every read
        goes through ContainsKey plus FirstOrDefault. appid is the v1 claim and
        azp the v2 one. Tokens for the Cognitive Services audience are v1
        today, but both are read so this cannot quietly start returning nothing
        if that changes.
      -->
      <set-variable name="callerAppId" value="@{
          var jwt = (Jwt)context.Variables["jwt"];
          var appId = jwt.Claims.ContainsKey("appid") ? jwt.Claims["appid"].FirstOrDefault() : null;
          if (string.IsNullOrEmpty(appId) && jwt.Claims.ContainsKey("azp")) {
              appId = jwt.Claims["azp"].FirstOrDefault();
          }
          return string.IsNullOrEmpty(appId) ? "unknown" : appId;
      }" />

      <!--
        Optional caller allow-list.

        validate-azure-ad-token has a client-application-ids element, but it
        takes one literal child per id and a named value cannot expand into
        several elements. Checking the claim here keeps the whole list in a
        single named value that setup_entra.py can rewrite without a policy
        redeployment.

        An empty list means "any client in this tenant holding a token for the
        audience", so an unset value degrades to the documented default instead
        of locking everybody out.
      -->
      <choose>
        <when condition="@{
            var allowed = "{{spectrum-entra-client-ids}}".Trim();
            if (string.IsNullOrEmpty(allowed)) { return false; }
            var caller = (string)context.Variables["callerAppId"];
            return !allowed.Split(',').Select(x => x.Trim()).Contains(caller);
        }">
          <return-response>
            <set-status code="403" reason="Forbidden" />
            <set-header name="Content-Type" exists-action="override">
              <value>application/json</value>
            </set-header>
            <set-body>{"error":{"code":"Forbidden","message":"Token is valid but this application is not on the gateway allow-list."}}</set-body>
          </return-response>
        </when>
      </choose>

      <!-- Record who called, so App Insights can tell the clients apart. -->
      <set-header name="x-shs-caller" exists-action="override">
        <value>@((string)context.Variables["callerAppId"])</value>
      </set-header>
    </when>

    <!--
      Fallback. Shared subscription key, accepted in every shape a real client
      might send it, because one unmodified OpenAI client has to reach every
      route:

        Ocp-Apim-Subscription-Key   APIM native, curl and the docs
        api-key                     Azure OpenAI SDK, Foundry BYOM connections
        Authorization header        the OpenAI SDK, which cannot be told otherwise
        ?subscription-key=<k>       browsers and quick links
    -->
    <otherwise>
      <set-variable name="credential" value="@{
          var headers = context.Request.Headers;
          var value = headers.GetValueOrDefault("Ocp-Apim-Subscription-Key", string.Empty);
          if (string.IsNullOrEmpty(value)) {
              value = headers.GetValueOrDefault("api-key", string.Empty);
          }
          if (string.IsNullOrEmpty(value)) {
              var authorization = headers.GetValueOrDefault("Authorization", string.Empty);
              var scheme = "Bearer ";
              if (authorization.StartsWith(scheme, StringComparison.OrdinalIgnoreCase)) {
                  value = authorization.Substring(scheme.Length).Trim();
              }
          }
          if (string.IsNullOrEmpty(value)) {
              value = context.Request.Url.Query.GetValueOrDefault("subscription-key", string.Empty);
          }
          return value;
      }" />
      <choose>
        <when condition="@(!string.Equals((string)context.Variables["credential"], "{{spectrum-gateway-key}}", StringComparison.Ordinal))">
          <return-response>
            <set-status code="401" reason="Unauthorized" />
            <set-header name="Content-Type" exists-action="override">
              <value>application/json</value>
            </set-header>
            <set-body>{"error":{"code":"Unauthorized","message":"Supply the gateway key as Ocp-Apim-Subscription-Key, api-key, or the Authorization header."}}</set-body>
          </return-response>
        </when>
      </choose>
    </otherwise>
  </choose>

  <!--
    Strip the caller's credentials before the request leaves the gateway.
    Each API then attaches its own backend credential, so a token or key that
    is valid at the gateway is never replayed against Foundry, the VM, or the
    laptop.
  -->
  <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
  <set-header name="api-key" exists-action="delete" />
  <set-header name="Authorization" exists-action="delete" />

  <!--
    Per-route token budget. The counter is keyed on the API so a runaway client
    on one option cannot starve the others, which makes the limit observable in
    a demo: hammer one route and the other three keep serving.

    estimate-prompt-tokens=false reads the real counts out of the response usage
    object rather than guessing from the prompt. More accurate, but the limit is
    applied after the offending call rather than before it.
  -->
  <llm-token-limit
    counter-key="@(context.Api.Id)"
    tokens-per-minute="{{spectrum-tokens-per-minute}}"
    estimate-prompt-tokens="false"
    tokens-consumed-header-name="x-shs-tokens-consumed"
    remaining-tokens-header-name="x-shs-tokens-remaining" />

  <!--
    Custom metrics to Application Insights. Dimensions are what make the four
    options comparable in one chart - split by ApiId to see cost and latency per
    hosting pattern side by side.
  -->
  <llm-emit-token-metric namespace="self-hosting-spectrum">
    <dimension name="ApiId" value="@(context.Api.Id)" />
    <dimension name="Option" value="@(context.Request.Headers.GetValueOrDefault("x-shs-option", "unknown"))" />
    <dimension name="Model" value="@(context.Request.Headers.GetValueOrDefault("x-shs-model", "unknown"))" />
  </llm-emit-token-metric>

  <!-- Echo which runtime served the call so clients can prove routing worked. -->
  <set-header name="x-shs-route" exists-action="override">
    <value>@(context.Api.Name)</value>
  </set-header>
</fragment>
